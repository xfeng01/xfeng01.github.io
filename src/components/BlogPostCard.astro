---
import type { CollectionEntry } from 'astro:content';
import MathText from './MathText.astro';
import { getBlogPostHref } from '../utils/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const href = getBlogPostHref(post);

// 年份已经写在左侧的分组标签里，这里只留月和日
const formatDay = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

{/* 每篇固定两行：标题 + 日期，下面是单行截断的摘要 */}
<article class="post-item relative grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 py-2">
  <h3 class="post-title text-[1.08rem] font-semibold leading-snug">
    <a href={href} class="post-link">
      <MathText text={post.data.title} />
    </a>
  </h3>
  <time datetime={post.data.date.toISOString().slice(0, 10)} class="post-date text-[0.8125rem] text-gray-500">
    {formatDay(post.data.date)}
  </time>

  <p class="post-description col-span-2 truncate text-[0.875rem] leading-[1.375rem] text-gray-500">
    {post.data.description}
  </p>
</article>

<style>
  .post-link {
    color: #111827;
    text-decoration: none;
    transition: color 150ms ease;
  }

  /* 把链接的点击区域铺满整个条目，这样点摘要、日期也能进文章 */
  .post-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* 悬停效果和首页项目标题（ProjectCard.astro 的 .project-title）保持一致 */
  .post-item:hover .post-link {
    color: #4b5563;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .post-link:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .post-title :global(.katex) {
    font-size: 1em;
  }

  .post-date {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* global.css 里的 p 规则不在 layer 里，会压过 mb-0 */
  .post-description {
    margin: 0.05rem 0 0;
  }
</style>
