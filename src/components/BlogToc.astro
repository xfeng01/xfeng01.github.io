---
// 浮动目录。样式在 src/styles/toc.css，和私密空间共用一份。
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="toc hidden xl:block" data-toc>
      <div class="toc-panel">
        <nav aria-label="Table of contents">
          <ul class="toc-list">
            {items.map((item) => (
              <li class={`toc-item toc-item-depth-${item.depth}`} data-toc-item={item.slug}>
                <a href={`#${item.slug}`} class="toc-link">
                  <span class="toc-label">{item.text}</span>
                  <span class="toc-dash" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

<script>
  // 滚动高亮：标出当前视口里最靠上的那个标题（h2 和 h3 一视同仁）。
  // 折叠态靠它把对应的短横线点黑，展开态靠它加粗对应条目。
  const initializeToc = () => {
    document.querySelectorAll<HTMLElement>('[data-toc]').forEach((toc) => {
      const items = Array.from(toc.querySelectorAll<HTMLElement>('[data-toc-item]'))
        .map((element) => ({
          element,
          heading: document.getElementById(element.dataset.tocItem ?? ''),
        }))
        .filter((item): item is { element: HTMLElement; heading: HTMLElement } =>
          item.heading !== null,
        );

      if (items.length === 0) return;

      const update = () => {
        let active = items[0];
        for (const item of items) {
          // 40 是刻意压小的。之前用 180 会出错：点某个 h2 跳过去后，
          // 它正下方的 h3 往往也落在 180px 内，于是高亮被下一条抢走 ——
          // 表现就是「点了 5 Trend Analysis，加粗却出现在它的子标题上」。
          if (item.heading.getBoundingClientRect().top <= 40) active = item;
        }
        for (const item of items) {
          item.element.classList.toggle('is-active', item === active);
        }
      };

      let queued = false;
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          update();
          queued = false;
        });
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      window.addEventListener('hashchange', onScroll);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeToc, { once: true });
  } else {
    initializeToc();
  }
</script>
