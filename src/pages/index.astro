---
import BasicLayout from '../layouts/BasicLayout.astro';
import { getEntry, getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';

// Fetch content for the "About" section
const aboutEntry = await getEntry('about', 'main');
const { Content: AboutContent } = await aboutEntry.render();

// Fetch all project entries and sort by date (newest first)
const projects = (await getCollection('projects')).sort((a, b) => {
  return b.data.date.getTime() - a.data.date.getTime();
});

// First-author (or co-first) work gets a full card; the rest is listed as compact rows
const yourName = "Xinsong Feng";
const isFirstAuthor = (project: (typeof projects)[number]) =>
  project.data.authors[0] === yourName || (project.data.coFirstAuthors ?? []).includes(yourName);
const firstAuthorProjects = projects.filter(isFirstAuthor);
const coAuthoredProjects = projects.filter((project) => !isFirstAuthor(project));
---

<BasicLayout>
	<!-- Capped so the text keeps a readable measure and never runs under the floated photo -->
	<div class="about max-w-[35rem] text-[0.95rem] leading-[1.6] text-gray-700">
		<AboutContent />
	</div>

	<section class="clear-both pt-10">
		<h2 class="font-display !mb-3 !text-[1.75rem] text-gray-900">Projects</h2>

		<h3 class="mb-2 text-[0.72rem] font-semibold uppercase tracking-[0.11em] text-gray-500">First-author</h3>
		<div>
			{firstAuthorProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>

		{coAuthoredProjects.length > 0 && (
			<div class="mt-8">
				<h3 class="mb-2 text-[0.72rem] font-semibold uppercase tracking-[0.11em] text-gray-500">Co-authored</h3>
				{coAuthoredProjects.map((project) => (
					<ProjectCard project={project} compact />
				))}
			</div>
		)}
	</section>
</BasicLayout>

<style>
	/* global.css sets an unlayered `p { mb-4 }` that margin utilities can't override, so tighten it here */
	.about :global(p) {
		margin-bottom: 0.75rem;
	}

	.about :global(p:last-child) {
		margin-bottom: 0;
	}
</style>


