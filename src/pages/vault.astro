---
// 私密空间。
//
// 这个页面本身是公开的，但它什么内容都不含 —— 内容全在 /vault.json 里，
// 是一坨 AES-GCM 密文。口令只存在于你脑子里，解密全程在浏览器本地完成。
// 内容由 `npm run vault` 生成，见 scripts/build-vault.mjs。
//
// 结构刻意对齐博客：解锁后是索引页（同 /blog），点进去是文章页
// （同 /blog/[slug]，含右侧固定 TOC）。用 location.hash 做路由，
// 所以浏览器的前进/后退都能用。
import BasicLayout from '../layouts/BasicLayout.astro';
---

<BasicLayout title="Vault | Xinsong Feng" showProfile={false} noindex={true} width="max-w-4xl">
  <!-- 口令闸门 -->
  <section id="gate">
    <div class="border-b border-gray-200 pb-5">
      <div class="max-w-2xl">
        <h2 class="mb-2 text-3xl font-semibold leading-tight text-gray-900">Vault</h2>
        <p class="mb-0 text-base leading-7 text-gray-600">
          This page is encrypted. Everything is decrypted locally in your browser.
        </p>
      </div>
    </div>

    <form id="gate-form" class="max-w-sm pt-7">
      <label for="passphrase" class="mb-2 block text-sm font-medium text-gray-700">Passphrase</label>
      <input
        id="passphrase"
        type="password"
        autocomplete="current-password"
        class="w-full rounded-md border border-gray-300 px-3 py-2 text-[0.95rem] text-gray-900 outline-none transition-colors focus:border-gray-900"
      />
      <div class="mt-4 flex items-center gap-3">
        <button
          id="unlock"
          type="submit"
          class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-85 disabled:opacity-50"
        >
          Unlock
        </button>
        <span id="status" class="text-sm text-gray-500"></span>
      </div>
    </form>
  </section>

  <!-- 索引页，对应 /blog -->
  <section id="index-view" class="hidden">
    <div class="border-b border-gray-200 pb-5">
      <div class="flex items-start justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="mb-2 text-3xl font-semibold leading-tight text-gray-900">Vault</h2>
          <p id="index-subtitle" class="mb-0 text-base leading-7 text-gray-600"></p>
        </div>
        <button
          type="button"
          data-lock
          class="mt-1 shrink-0 rounded-md border border-gray-300 px-3 py-1.5 text-[0.8rem] font-medium text-gray-600 transition-colors hover:border-gray-900 hover:text-gray-900"
        >
          Lock
        </button>
      </div>
    </div>

    <div id="entry-list" class="divide-y divide-gray-200"></div>
  </section>

  <!-- 文章页，对应 /blog/[slug] -->
  <article id="entry-view" class="hidden min-w-0">
    <header class="mb-7 border-b border-gray-200 pb-5">
      <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.85rem] font-medium text-gray-500">
        <a href="#" class="vault-crumb no-underline">Vault</a>
        <span>/</span>
        <span id="entry-date"></span>
        <!-- display:contents，让注入的语言链接直接参与外层的 flex 布局 -->
        <span id="entry-langs" class="contents"></span>
        <span class="text-gray-300">/</span>
        <button type="button" data-lock class="vault-crumb cursor-pointer">Lock</button>
      </div>
      <h2 id="entry-title" class="mb-3 text-[1.72rem] font-semibold leading-tight text-gray-900 sm:text-[2rem]"></h2>
      <p id="entry-description" class="mb-0 max-w-2xl text-[0.96rem] leading-6 text-gray-600"></p>
      <p id="entry-tags" class="mt-3 mb-0 text-[0.72rem] font-semibold uppercase tracking-[0.11em] text-gray-400"></p>
    </header>

    <div id="entry-body" class="blog-content text-gray-800"></div>
  </article>

  <!--
    浮动目录。结构和类名与 BlogToc.astro 完全一致，样式共用 src/styles/toc.css。
    显示/隐藏走 .vault-toc-off，不要去动这里的 hidden ——
    hidden 和 xl:block 是配套的，摘掉 hidden 会让目录在移动端漏出来。
  -->
  <aside id="entry-toc" class="toc vault-toc-off hidden xl:block" data-toc>
    <div class="toc-panel">
      <nav aria-label="Table of contents">
        <ul id="toc-list" class="toc-list"></ul>
      </nav>
    </div>
  </aside>
</BasicLayout>

<!--
  下面这些样式必须是 global 的：内容由 JS 用 innerHTML 生成，
  拿不到 Astro 给作用域样式加的那个 data 属性。
-->
<style is:global>
  /* TOC 的开关。用 !important 是因为要盖过 Tailwind 的 xl:block。 */
  .vault-toc-off {
    display: none !important;
  }

  .vault-summary {
    list-style: none;
  }

  .vault-summary::-webkit-details-marker {
    display: none;
  }

  .vault-title {
    color: #111827;
    transition: color 150ms ease;
  }

  .vault-summary:hover .vault-title {
    color: #4b5563;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .vault-title .katex {
    font-size: 1em;
  }

  .vault-read-link {
    color: #111827;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .vault-read-link:hover {
    color: #4b5563;
  }

  .vault-crumb {
    background: none;
    border: 0;
    color: #9ca3af;
    font: inherit;
    padding: 0;
    transition: color 150ms ease;
  }

  .vault-crumb:hover {
    color: #111827;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  /* 语言切换链接，同 BlogArticle.astro 里的 .language-link */
  .vault-language-link {
    color: #9ca3af;
    transition: color 150ms ease;
  }

  .vault-language-link:hover {
    color: #111827;
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

</style>

<script>
  const SESSION_KEY = 'vault:passphrase';

  type TocItem = { depth: number; slug: string; text: string };
  type Lang = 'en' | 'zh';
  type Note = {
    slug: string;
    lang: Lang;
    translationKey: string;
    title: string;
    titleHtml: string;
    date: string | null;
    tags: string[];
    description: string;
    descriptionHtml: string;
    html: string;
    toc: TocItem[];
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const gate = $('gate');
  const gateForm = $<HTMLFormElement>('gate-form');
  const passphraseInput = $<HTMLInputElement>('passphrase');
  const unlockButton = $<HTMLButtonElement>('unlock');
  const statusLine = $('status');

  const indexView = $('index-view');
  const indexSubtitle = $('index-subtitle');
  const entryList = $('entry-list');

  const entryView = $('entry-view');
  const entryDate = $('entry-date');
  const entryTitle = $('entry-title');
  const entryDescription = $('entry-description');
  const entryTags = $('entry-tags');
  const entryBody = $('entry-body');

  const entryLangs = $('entry-langs');
  const entryToc = $('entry-toc');
  const tocList = $('toc-list');

  let notes: Note[] = [];

  /* ---------- 语言，语义对齐 src/utils/blog.ts ---------- */

  const LANG_LABELS: Record<Lang, string> = { en: 'English', zh: '中文' };
  const LANG_ORDER: Lang[] = ['en', 'zh'];

  // hash 的形状刻意照搬博客的 URL：en 用 #key，zh 用 #zh/key。
  const hashFor = (note: Note) =>
    note.lang === 'zh'
      ? `#zh/${encodeURIComponent(note.translationKey)}`
      : `#${encodeURIComponent(note.translationKey)}`;

  const translationsOf = (note: Note) =>
    notes.filter((candidate) => candidate.translationKey === note.translationKey);

  // 索引页每个 translationKey 只出一条，优先英文版。
  // （博客是直接过滤掉非英文的，那样会让只有中文版的条目彻底消失 ——
  //  在私密空间里弄丢东西代价太大，所以这里退回该组的第一篇。）
  function indexEntries() {
    const seen = new Set<string>();
    const entries: Note[] = [];

    for (const note of notes) {
      if (seen.has(note.translationKey)) continue;
      seen.add(note.translationKey);
      const group = translationsOf(note);
      entries.push(group.find((candidate) => candidate.lang === 'en') ?? group[0]);
    }

    return entries;
  }

  /* ---------- 解密 ---------- */

  const base64ToBytes = (value: string) =>
    Uint8Array.from(atob(value), (char) => char.charCodeAt(0));

  async function gunzip(bytes: Uint8Array) {
    const stream = new Blob([bytes as unknown as BlobPart])
      .stream()
      .pipeThrough(new DecompressionStream('gzip'));
    return new Uint8Array(await new Response(stream).arrayBuffer());
  }

  async function decryptVault(passphrase: string): Promise<Note[]> {
    const response = await fetch('/vault.json', { cache: 'no-store' });
    if (!response.ok) throw new Error('Vault data not found.');

    const envelope = await response.json();
    const baseKey = await crypto.subtle.importKey(
      'raw',
      new TextEncoder().encode(passphrase),
      'PBKDF2',
      false,
      ['deriveKey'],
    );
    const key = await crypto.subtle.deriveKey(
      {
        name: 'PBKDF2',
        salt: base64ToBytes(envelope.salt),
        iterations: envelope.kdf.iterations,
        hash: envelope.kdf.hash,
      },
      baseKey,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );

    let plaintext: Uint8Array;
    try {
      const decrypted = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: base64ToBytes(envelope.iv) },
        key,
        base64ToBytes(envelope.data),
      );
      plaintext = new Uint8Array(decrypted);
    } catch {
      // AES-GCM 的认证标签对不上 —— 口令错了，或者密文被改过。
      throw new Error('Wrong passphrase.');
    }

    if (envelope.compression === 'gzip') plaintext = await gunzip(plaintext);

    return JSON.parse(new TextDecoder().decode(plaintext)).notes as Note[];
  }

  /* ---------- 渲染 ---------- */

  const formatDate = (value: string | null) =>
    value
      ? new Date(value).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        })
      : '';

  // 索引页的条目，结构对齐 BlogPostCard.astro
  function renderIndex() {
    const entries = indexEntries();
    indexSubtitle.textContent = `${entries.length} encrypted ${entries.length === 1 ? 'entry' : 'entries'}, decrypted locally.`;
    entryList.innerHTML = entries
      .map((note) => {
        const tags = note.tags.length
          ? `<p class="mb-2 text-[0.72rem] font-semibold uppercase tracking-[0.11em] text-gray-400">${note.tags.join(' / ')}</p>`
          : '';
        const description = note.descriptionHtml
          ? `<p class="mb-2 max-w-3xl text-[0.95rem] leading-6 text-gray-600">${note.descriptionHtml}</p>`
          : '';

        return `<article>
  <details class="py-3">
    <summary class="vault-summary grid cursor-pointer gap-2 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-6">
      <span class="mb-0 pt-0.5 text-sm leading-6 text-gray-500">${formatDate(note.date)}</span>
      <h3 class="vault-title mb-0 text-[1.08rem] font-semibold leading-snug text-gray-900">${note.titleHtml}</h3>
    </summary>
    <div class="grid gap-2 pt-2 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:gap-6">
      <div class="hidden sm:block"></div>
      <div class="min-w-0">
        ${tags}${description}
        <a href="${hashFor(note)}" class="vault-read-link">Read entry</a>
      </div>
    </div>
  </details>
</article>`;
      })
      .join('');
  }

  // 浮动目录。生成的标签和类名必须和 BlogToc.astro 完全一致 ——
  // 两边共用 src/styles/toc.css 那一份样式。
  function renderToc(note: Note) {
    const items = note.toc ?? [];
    if (items.length === 0) {
      entryToc.classList.add('vault-toc-off');
      return;
    }

    tocList.innerHTML = items
      .map(
        (item) =>
          `<li class="toc-item toc-item-depth-${item.depth}" data-toc-item="${item.slug}">` +
          `<a href="${hashFor(note)}::${item.slug}" class="toc-link">` +
          `<span class="toc-label">${item.text}</span>` +
          `<span class="toc-dash" aria-hidden="true"></span>` +
          `</a></li>`,
      )
      .join('');

    entryToc.classList.remove('vault-toc-off');
  }

  // 语言切换，结构对齐 BlogArticle.astro 的 languageLinks：
  // 只有该 translationKey 下确实存在多个语言版本时才显示。
  function renderLanguageLinks(note: Note) {
    const group = translationsOf(note);
    const links = LANG_ORDER.map((lang) => {
      const entry = group.find((candidate) => candidate.lang === lang);
      return entry ? { entry, lang } : null;
    }).filter((link): link is { entry: Note; lang: Lang } => link !== null);

    if (links.length < 2) {
      entryLangs.innerHTML = '';
      return;
    }

    const rendered = links
      .map(({ entry, lang }, index) => {
        const separator = index > 0 ? '<span class="text-gray-300">/</span>' : '';
        const label = LANG_LABELS[lang];
        const body =
          entry.slug === note.slug
            ? `<span class="text-gray-900">${label}</span>`
            : `<a href="${hashFor(entry)}" class="vault-language-link no-underline">${label}</a>`;
        return separator + body;
      })
      .join('');

    entryLangs.innerHTML =
      `<span class="text-gray-300">/</span>` +
      `<nav class="inline-flex items-center gap-1" aria-label="Language versions">${rendered}</nav>`;
  }

  function renderEntry(note: Note) {
    entryDate.textContent = formatDate(note.date);
    renderLanguageLinks(note);
    entryTitle.innerHTML = note.titleHtml;
    entryDescription.innerHTML = note.descriptionHtml;
    entryDescription.classList.toggle('hidden', !note.descriptionHtml);
    entryTags.textContent = note.tags.join(' / ');
    entryTags.classList.toggle('hidden', note.tags.length === 0);
    entryBody.innerHTML = note.html;
    renderToc(note);
  }

  /* ---------- TOC 滚动高亮，同 BlogToc 的 compact 行为 ---------- */

  let detachScrollSpy: (() => void) | null = null;

  function attachScrollSpy() {
    detachScrollSpy?.();

    const items = Array.from(tocList.querySelectorAll<HTMLElement>('[data-toc-item]'))
      .map((element) => ({
        element,
        heading: document.getElementById(element.dataset.tocItem ?? ''),
      }))
      .filter((item): item is { element: HTMLElement; heading: HTMLElement } => item.heading !== null);

    if (items.length === 0) return;

    // 标出视口里最靠上的那个标题（h2 / h3 一视同仁）：
    // 折叠态用它把对应的短横线点黑，展开态用它加粗对应条目。
    const update = () => {
      let active = items[0];
      for (const item of items) {
        // 40 是刻意压小的。之前用 180 会出错：点某个 h2 跳过去后，
        // 它正下方的 h3 往往也落在 180px 内，于是高亮被下一条抢走 ——
        // 表现就是「点了 5 Trend Analysis，加粗却出现在它的子标题上」。
        if (item.heading.getBoundingClientRect().top <= 40) active = item;
      }

      // 页面滚到底时，末尾那几个标题永远到不了顶部 —— 可滚动距离不够了。
      // 只靠上面那条规则，高亮会永久卡在倒数第二个标题上。
      // 这时改取最后一个已经进入视口的标题。
      const reachedBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (reachedBottom) {
        for (const item of items) {
          if (item.heading.getBoundingClientRect().top < window.innerHeight) active = item;
        }
      }

      for (const item of items) {
        item.element.classList.toggle('is-active', item === active);
      }
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        update();
        queued = false;
      });
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    // 已经在底部时点末尾的标题不会产生滚动，也就没有 scroll 事件，
    // 高亮就不会重算 —— 所以 hashchange 也要触发一次。
    window.addEventListener('hashchange', onScroll);
    detachScrollSpy = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      window.removeEventListener('hashchange', onScroll);
      detachScrollSpy = null;
    };
  }

  /* ---------- 路由：#slug 看文章，#slug::heading 跳到小节 ---------- */

  function show(view: 'gate' | 'index' | 'entry') {
    gate.classList.toggle('hidden', view !== 'gate');
    indexView.classList.toggle('hidden', view !== 'index');
    entryView.classList.toggle('hidden', view !== 'entry');
    if (view !== 'entry') {
      entryToc.classList.add('vault-toc-off');
      detachScrollSpy?.();
    }
  }

  // 记住当前展示的是哪篇。点 TOC 里的锚点时 hash 会变，
  // 但文章没换 —— 这时只滚动，不重渲染（否则 KaTeX 会整篇重排闪一下）。
  let currentSlug: string | null = null;

  function route() {
    if (notes.length === 0) return;

    // #key / #zh/key，可选再跟 ::heading
    const [routePart, headingId] = location.hash.replace(/^#/, '').split('::');
    const isZh = routePart.startsWith('zh/');
    const key = decodeURIComponent(isZh ? routePart.slice(3) : routePart);
    const lang: Lang = isZh ? 'zh' : 'en';
    const note = key
      ? notes.find((candidate) => candidate.translationKey === key && candidate.lang === lang)
      : undefined;

    if (!note) {
      currentSlug = null;
      show('index');
      return;
    }

    const isSameEntry = currentSlug === note.slug;
    if (!isSameEntry) {
      renderEntry(note);
      currentSlug = note.slug;
      show('entry');
      attachScrollSpy();
    }

    // 等一帧，让 KaTeX 撑开的高度稳定后再滚，否则锚点会偏。
    requestAnimationFrame(() => {
      if (headingId) document.getElementById(headingId)?.scrollIntoView({ block: 'start' });
      else if (!isSameEntry) window.scrollTo({ top: 0 });
    });
  }

  /* ---------- 解锁流程 ---------- */

  async function attempt(passphrase: string, { remember = true } = {}) {
    unlockButton.disabled = true;
    statusLine.textContent = 'Decrypting…';

    try {
      notes = await decryptVault(passphrase);
      // 存 sessionStorage：刷新不用重输，关掉标签页就没了。
      if (remember) sessionStorage.setItem(SESSION_KEY, passphrase);
      statusLine.textContent = '';
      renderIndex();
      route();
    } catch (error) {
      sessionStorage.removeItem(SESSION_KEY);
      statusLine.textContent = error instanceof Error ? error.message : String(error);
      passphraseInput.select();
    } finally {
      unlockButton.disabled = false;
    }
  }

  gateForm.addEventListener('submit', (event) => {
    event.preventDefault();
    if (passphraseInput.value) attempt(passphraseInput.value);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-lock]').forEach((button) => {
    button.addEventListener('click', () => {
      sessionStorage.removeItem(SESSION_KEY);
      location.hash = '';
      location.reload();
    });
  });

  window.addEventListener('hashchange', route);

  const remembered = sessionStorage.getItem(SESSION_KEY);
  if (remembered) {
    attempt(remembered, { remember: false });
  } else {
    show('gate');
    passphraseInput.focus();
  }
</script>
